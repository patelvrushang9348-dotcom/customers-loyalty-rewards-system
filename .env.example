# Copy to .env (or run: python scripts/init_env.py) and replace every placeholder.
# NEVER commit the real .env file.

# Signs session cookies. Use a long random string.
SECRET_KEY=change-me-long-random-string

# Secret "pepper" used to hash/validate reward codes. If you lose or change it,
# every already-printed code stops working. Back it up separately from the DB.
CODE_PEPPER=change-me-another-long-random-string

# SQLite file location
DATABASE_PATH=loyalty.db

# First admin account, created automatically on first start if no admin exists.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-strong-password

# Fraud controls (defaults shown)
MAX_FAILED_ATTEMPTS_PER_USER=5
MAX_FAILED_ATTEMPTS_PER_IP=20
LOCKOUT_WINDOW_MINUTES=15
CODE_VALID_DAYS=365

# Set to the number of reverse proxies in front of the app (0 = none)
NUM_PROXIES=0

# Set to 1 only when serving over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=0
