# Copy to .env and replace every value. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
# Key used to hash box codes (HMAC). Changing it invalidates ALL existing codes.
CODE_PEPPER=change-me-to-another-long-random-string
# SQLite database file (created automatically)
DB_PATH=loyalty.db
# First admin account, created on startup if it does not exist
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-strong-password
# Set to 1 only for local development
FLASK_DEBUG=0
# Set to 1 when deployed behind HTTPS
COOKIE_SECURE=0
PORT=5000
